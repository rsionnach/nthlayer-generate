{
  "exit": 0,
  "files": {
    "loki-alerts.yaml": {
      "groups": [
        {
          "name": "notification-worker",
          "rules": [
            {
              "alert": "notification-worker_ApplicationError",
              "annotations": {
                "description": "Error-level log entries detected in application logs.",
                "summary": "[notification-worker] Application errors detected"
              },
              "expr": "sum(count_over_time({app=\"notification-worker\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
              "for": "5m",
              "labels": {
                "service": "notification-worker",
                "severity": "warning",
                "source": "service",
                "team": "platform",
                "technology": "worker",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_ApplicationHighErrorRate",
              "annotations": {
                "description": "Application is experiencing a high rate of errors.",
                "summary": "[notification-worker] High error rate in application"
              },
              "expr": "sum(count_over_time({app=\"notification-worker\"} |~ \"(?i)error|exception\" [5m])) > 100",
              "for": "5m",
              "labels": {
                "service": "notification-worker",
                "severity": "critical",
                "source": "service",
                "team": "platform",
                "technology": "worker",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_ApplicationPanic",
              "annotations": {
                "description": "Application appears to have crashed or panicked.",
                "summary": "[notification-worker] Application panic/crash detected"
              },
              "expr": "count_over_time({app=\"notification-worker\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "service": "notification-worker",
                "severity": "critical",
                "source": "service",
                "team": "platform",
                "technology": "worker",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisClusterDown",
              "annotations": {
                "description": "Redis cluster is in a down state. Some slots may not be covered.",
                "summary": "[notification-worker/redis] Redis cluster down"
              },
              "expr": "count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"CLUSTERDOWN|cluster.*down|slots.*not covered\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "critical",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisConnectionRefused",
              "annotations": {
                "description": "Applications cannot connect to Redis. Check if Redis is running and acce...",
                "summary": "[notification-worker/redis] Redis connection refused"
              },
              "expr": "count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"Connection refused|ECONNREFUSED\" [1m]) > 0",
              "for": "1m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "critical",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisOutOfMemory",
              "annotations": {
                "description": "Redis is out of memory. Consider increasing maxmemory or reviewing evict...",
                "summary": "[notification-worker/redis] Redis out of memory"
              },
              "expr": "count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"OOM|out of memory|Can't save\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "critical",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisRDBSaveFailed",
              "annotations": {
                "description": "Redis background save (RDB) failed. Check disk space and permissions.",
                "summary": "[notification-worker/redis] Redis RDB save failed"
              },
              "expr": "count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"MISCONF|Background saving|RDB\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "warning",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisReplicationBroken",
              "annotations": {
                "description": "Redis replication to master is broken. Check network connectivity and ma...",
                "summary": "[notification-worker/redis] Redis replication broken"
              },
              "expr": "count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"MASTER aborted|Disconnected from MASTER|replication\" [1m]) > 0",
              "for": "1m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "critical",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            },
            {
              "alert": "notification-worker_redis_RedisSlowlog",
              "annotations": {
                "description": "Slow Redis commands detected. Review command patterns and consider optim...",
                "summary": "[notification-worker/redis] Redis slow commands detected"
              },
              "expr": "sum(count_over_time({app=\"redis\", service=\"notification-worker\"} |~ \"Slow|slowlog\" [5m])) > 10",
              "for": "5m",
              "labels": {
                "dependency": "redis",
                "service": "notification-worker",
                "severity": "warning",
                "source": "dependency",
                "team": "platform",
                "technology": "redis",
                "tier": "high"
              }
            }
          ]
        }
      ]
    }
  },
