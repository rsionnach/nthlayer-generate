{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "identity-service_health_metrics",
          "rules": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service"
              },
              "record": "service:http_request_duration_seconds:p99"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"identity-service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service"
              },
              "record": "service:http_requests:rate5m"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "identity-service_slo_metrics",
          "rules": [
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"identity-service\",slo=\"availability\"}) / (1 - 0.9998999999999999))",
              "labels": {
                "objective": "99.99",
                "service": "identity-service",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"identity-service\"}[5m]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"identity-service\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"identity-service\",slo=\"latency-p95\"}",
              "labels": {
                "objective": "99.5",
                "service": "identity-service",
                "slo": "latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"identity-service\",slo=\"latency-p99\"} / slo:latency_requests_total:30d{service=\"identity-service\",slo=\"latency-p99\"}",
              "labels": {
                "objective": "98.0",
                "service": "identity-service",
                "slo": "latency-p99"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:requests_success:30d{service=\"identity-service\",slo=\"availability\"} / slo:requests_total:30d{service=\"identity-service\",slo=\"availability\"}",
              "labels": {
                "objective": "99.99",
                "service": "identity-service",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"identity-service\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p95",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"identity-service\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p99",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"identity-service\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"identity-service\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "latency-p99"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"identity-service\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"identity-service\"}[30d]))",
              "labels": {
                "service": "identity-service",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            }
          ]
        }
      ]
    }
  }
}
