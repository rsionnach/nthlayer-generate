    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "api-minimal_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"api-minimal\"}[30d]))",
              "labels": {
                "service": "api-minimal",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"api-minimal\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "api-minimal",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"api-minimal\",slo=\"availability\"} / slo:requests_total:30d{service=\"api-minimal\",slo=\"availability\"}",
              "labels": {
                "objective": "99.9",
                "service": "api-minimal",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"api-minimal\",slo=\"availability\"}) / (1 - 0.9990000000000001))",
              "labels": {
                "objective": "99.9",
                "service": "api-minimal",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"api-minimal\"}[30d]))",
              "labels": {
                "service": "api-minimal",
                "slo": "latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"api-minimal\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "api-minimal",
                "slo": "latency-p95",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"api-minimal\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"api-minimal\",slo=\"latency-p95\"}",
              "labels": {
                "objective": "99.0",
                "service": "api-minimal",
                "slo": "latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"api-minimal\"}[5m]))",
              "labels": {
