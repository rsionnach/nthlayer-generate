{
  "groups": [
    {
      "interval": "30s",
      "name": "investigation-agent_judgment_metrics",
      "rules": [
        {
          "expr": "avg(ai_gate_calibration_error{service=\"investigation-agent\"})",
          "labels": {
            "service": "investigation-agent",
            "slo": "calibration",
            "target": "0.03"
          },
          "record": "ai_gate:calibration:ece"
        },
        {
          "expr": "avg(ai_gate_calibration_error{service=\"investigation-agent\",confidence_bucket=\"low\"})",
          "labels": {
            "confidence_bucket": "low",
            "service": "investigation-agent"
          },
          "record": "ai_gate:calibration_bucket:low"
        },
        {
          "expr": "avg(ai_gate_calibration_error{service=\"investigation-agent\",confidence_bucket=\"medium\"})",
          "labels": {
            "confidence_bucket": "medium",
            "service": "investigation-agent"
          },
          "record": "ai_gate:calibration_bucket:medium"
        },
        {
          "expr": "avg(ai_gate_calibration_error{service=\"investigation-agent\",confidence_bucket=\"high\"})",
          "labels": {
            "confidence_bucket": "high",
            "service": "investigation-agent"
          },
          "record": "ai_gate:calibration_bucket:high"
        },
        {
          "expr": "avg(ai_gate_calibration_brier{service=\"investigation-agent\"})",
          "labels": {
            "service": "investigation-agent",
            "slo": "calibration",
            "target": "0.05"
          },
          "record": "ai_gate:calibration:brier"
        }
      ]
    },
    {
      "interval": "30s",
      "name": "investigation-agent_health_metrics",
      "rules": [
        {
          "expr": "sum(rate(ai_gate_decisions_total{service=\"investigation-agent\"}[5m]))",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:ai_gate_decisions:rate5m"
        },
        {
          "expr": "avg(ai_gate_confidence_score{service=\"investigation-agent\"})",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:ai_gate_confidence:avg"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"investigation-agent\"}[5m]))",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:http_requests:rate5m"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"investigation-agent\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"investigation-agent\"}[5m]))",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:http_errors:rate5m"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"investigation-agent\"}[5m]))",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"investigation-agent\"}[5m]))",
          "labels": {
            "service": "investigation-agent"
          },
          "record": "service:http_request_duration_seconds:p99"
        }
      ]
    }
  ]
}
