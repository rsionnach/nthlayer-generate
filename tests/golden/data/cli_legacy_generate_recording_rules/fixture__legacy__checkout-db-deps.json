  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "checkout-db-deps_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"checkout-db-deps\"}[30d]))",
              "labels": {
                "service": "checkout-db-deps",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"checkout-db-deps\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "checkout-db-deps",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"checkout-db-deps\",slo=\"availability\"} / slo:requests_total:30d{service=\"checkout-db-deps\",slo=\"availability\"}",
              "labels": {
                "objective": "99.95",
                "service": "checkout-db-deps",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"checkout-db-deps\",slo=\"availability\"}) / (1 - 0.9995))",
              "labels": {
                "objective": "99.95",
                "service": "checkout-db-deps",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "checkout-db-deps_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(http_requests_total{service=\"checkout-db-deps\"}[5m]))",
              "labels": {
                "service": "checkout-db-deps"
              },
              "record": "service:http_requests:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"checkout-db-deps\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"checkout-db-deps\"}[5m]))",
              "labels": {
                "service": "checkout-db-deps"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-db-deps\"}[5m]))",
              "labels": {
                "service": "checkout-db-deps"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-db-deps\"}[5m]))",
              "labels": {
                "service": "checkout-db-deps"
              },
              "record": "service:http_request_duration_seconds:p99"
            }
          ]
        }
      ]
    }
  },
