    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "payment-api_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"payment-api\"}[30d]))",
              "labels": {
                "service": "payment-api",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"payment-api\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "payment-api",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"payment-api\",slo=\"availability\"} / slo:requests_total:30d{service=\"payment-api\",slo=\"availability\"}",
              "labels": {
                "objective": "99.5",
                "service": "payment-api",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"payment-api\",slo=\"availability\"}) / (1 - 0.995))",
              "labels": {
                "objective": "99.5",
                "service": "payment-api",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"payment-api\"}[30d]))",
              "labels": {
                "service": "payment-api",
                "slo": "latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"payment-api\",le=\"1.0\"}[30d]))",
              "labels": {
                "service": "payment-api",
                "slo": "latency-p95",
                "threshold": "1000ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"payment-api\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"payment-api\",slo=\"latency-p95\"}",
              "labels": {
                "objective": "95.0",
                "service": "payment-api",
                "slo": "latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"payment-api\"}[5m]))",
              "labels": {
