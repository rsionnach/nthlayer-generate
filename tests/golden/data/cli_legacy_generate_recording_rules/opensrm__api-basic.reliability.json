{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "user-api_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"user-api\"}[30d]))",
              "labels": {
                "service": "user-api",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"user-api\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "user-api",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"user-api\",slo=\"availability\"} / slo:requests_total:30d{service=\"user-api\",slo=\"availability\"}",
              "labels": {
                "objective": "99.9",
                "service": "user-api",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"user-api\",slo=\"availability\"}) / (1 - 0.9990000000000001))",
              "labels": {
                "objective": "99.9",
                "service": "user-api",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"user-api\"}[30d]))",
              "labels": {
                "service": "user-api",
                "slo": "latency"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"user-api\",le=\"0.2\"}[30d]))",
              "labels": {
                "service": "user-api",
                "slo": "latency",
                "threshold": "200.0ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"user-api\",slo=\"latency\"} / slo:latency_requests_total:30d{service=\"user-api\",slo=\"latency\"}",
              "labels": {
                "objective": "200.0",
                "service": "user-api",
                "slo": "latency"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api",
                "slo": "latency"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api",
                "slo": "latency"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api",
                "slo": "latency"
              },
              "record": "slo:http_request_duration_seconds:p99"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "user-api_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(http_requests_total{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api"
              },
              "record": "service:http_requests:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"user-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"user-api\"}[5m]))",
              "labels": {
                "service": "user-api"
              },
              "record": "service:http_request_duration_seconds:p99"
            }
          ]
        }
      ]
    }
  },
  "text": [
