{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "pricing-agent_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(ai_gate_decisions_total{service=\"pricing-agent\"}[5m]))",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:ai_gate_decisions:rate5m"
            },
            {
              "expr": "avg(ai_gate_confidence_score{service=\"pricing-agent\"})",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:ai_gate_confidence:avg"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"pricing-agent\"}[5m]))",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:http_requests:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"pricing-agent\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"pricing-agent\"}[5m]))",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"pricing-agent\"}[5m]))",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"pricing-agent\"}[5m]))",
              "labels": {
                "service": "pricing-agent"
              },
              "record": "service:http_request_duration_seconds:p99"
            }
          ]
        }
      ]
    }
  },
  "text": [
    "",
