{
  "exit": 0,
  "files": {
    "alerts.yaml": {
      "groups": [
        {
          "name": "api-minimal-slo",
          "rules": [
            {
              "alert": "SLONotEvaluable",
              "annotations": {
                "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
                "summary": "api-minimal: SLO availability not evaluable"
              },
              "expr": "absent(slo:availability:ratio{service=\"api-minimal\",slo=\"availability\"}) or (slo:availability:ratio{service=\"api-minimal\",slo=\"availability\"} != slo:availability:ratio{service=\"api-minimal\",slo=\"availability\"})",
              "for": "1h",
              "labels": {
                "routing": "self",
                "service": "api-minimal",
                "severity": "info",
                "slo": "availability",
                "team": "platform",
                "tier": "critical"
              }
            },
            {
              "alert": "SLONotEvaluable",
              "annotations": {
                "description": "slo:latency:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
                "summary": "api-minimal: SLO latency-p95 not evaluable"
              },
              "expr": "absent(slo:latency:ratio{service=\"api-minimal\",slo=\"latency-p95\"}) or (slo:latency:ratio{service=\"api-minimal\",slo=\"latency-p95\"} != slo:latency:ratio{service=\"api-minimal\",slo=\"latency-p95\"})",
              "for": "1h",
              "labels": {
                "routing": "self",
                "service": "api-minimal",
                "severity": "info",
                "slo": "latency-p95",
                "team": "platform",
                "tier": "critical"
              }
            }
          ]
        }
      ]
    }
  },
  "text": [
    "",
    "╭──╮",
