{
  "groups": [
    {
      "name": "search-api",
      "rules": [
        {
          "alert": "search-api_ApplicationError",
          "annotations": {
            "description": "Error-level log entries detected in application logs.",
            "summary": "[search-api] Application errors detected"
          },
          "expr": "sum(count_over_time({app=\"search-api\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
          "for": "5m",
          "labels": {
            "service": "search-api",
            "severity": "warning",
            "source": "service",
            "team": "search",
            "technology": "api",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_ApplicationHighErrorRate",
          "annotations": {
            "description": "Application is experiencing a high rate of errors.",
            "summary": "[search-api] High error rate in application"
          },
          "expr": "sum(count_over_time({app=\"search-api\"} |~ \"(?i)error|exception\" [5m])) > 100",
          "for": "5m",
          "labels": {
            "service": "search-api",
            "severity": "critical",
            "source": "service",
            "team": "search",
            "technology": "api",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_ApplicationPanic",
          "annotations": {
            "description": "Application appears to have crashed or panicked.",
            "summary": "[search-api] Application panic/crash detected"
          },
          "expr": "count_over_time({app=\"search-api\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "service": "search-api",
            "severity": "critical",
            "source": "service",
            "team": "search",
            "technology": "api",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_elasticsearch_ElasticsearchClusterRed",
          "annotations": {
            "description": "Elasticsearch cluster is in RED state. Some primary shards are unallocated.",
            "summary": "[search-api/elasticsearch] Elasticsearch cluster status RED"
          },
          "expr": "count_over_time({app=\"elasticsearch\", service=\"search-api\"} |~ \"cluster.*red|RED.*status\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "dependency": "elasticsearch",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "elasticsearch",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_elasticsearch_ElasticsearchClusterYellow",
          "annotations": {
            "description": "Elasticsearch cluster is YELLOW. Replica shards are unallocated.",
            "summary": "[search-api/elasticsearch] Elasticsearch cluster status YELLOW"
          },
          "expr": "count_over_time({app=\"elasticsearch\", service=\"search-api\"} |~ \"cluster.*yellow|YELLOW.*status\" [1m]) > 0",
          "for": "10m",
          "labels": {
            "dependency": "elasticsearch",
            "service": "search-api",
            "severity": "warning",
            "source": "dependency",
            "team": "search",
            "technology": "elasticsearch",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_elasticsearch_ElasticsearchOutOfMemory",
          "annotations": {
            "description": "Elasticsearch is experiencing memory issues. Consider increasing heap size.",
            "summary": "[search-api/elasticsearch] Elasticsearch out of memory"
          },
          "expr": "count_over_time({app=\"elasticsearch\", service=\"search-api\"} |~ \"OutOfMemoryError|heap.*space|CircuitBreakingException\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "dependency": "elasticsearch",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "elasticsearch",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_elasticsearch_ElasticsearchShardFailure",
          "annotations": {
            "description": "Elasticsearch shard allocation failure detected.",
            "summary": "[search-api/elasticsearch] Elasticsearch shard failure"
          },
          "expr": "count_over_time({app=\"elasticsearch\", service=\"search-api\"} |~ \"shard.*fail|ShardNotFound|unassigned.*shard\" [1m]) > 0",
          "for": "5m",
          "labels": {
            "dependency": "elasticsearch",
            "service": "search-api",
            "severity": "warning",
            "source": "dependency",
            "team": "search",
            "technology": "elasticsearch",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisClusterDown",
          "annotations": {
            "description": "Redis cluster is in a down state. Some slots may not be covered.",
            "summary": "[search-api/redis] Redis cluster down"
          },
          "expr": "count_over_time({app=\"redis\", service=\"search-api\"} |~ \"CLUSTERDOWN|cluster.*down|slots.*not covered\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisConnectionRefused",
          "annotations": {
            "description": "Applications cannot connect to Redis. Check if Redis is running and acce...",
            "summary": "[search-api/redis] Redis connection refused"
          },
          "expr": "count_over_time({app=\"redis\", service=\"search-api\"} |~ \"Connection refused|ECONNREFUSED\" [1m]) > 0",
          "for": "1m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisOutOfMemory",
          "annotations": {
            "description": "Redis is out of memory. Consider increasing maxmemory or reviewing evict...",
            "summary": "[search-api/redis] Redis out of memory"
          },
          "expr": "count_over_time({app=\"redis\", service=\"search-api\"} |~ \"OOM|out of memory|Can't save\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisRDBSaveFailed",
          "annotations": {
            "description": "Redis background save (RDB) failed. Check disk space and permissions.",
            "summary": "[search-api/redis] Redis RDB save failed"
          },
          "expr": "count_over_time({app=\"redis\", service=\"search-api\"} |~ \"MISCONF|Background saving|RDB\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "warning",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisReplicationBroken",
          "annotations": {
            "description": "Redis replication to master is broken. Check network connectivity and ma...",
            "summary": "[search-api/redis] Redis replication broken"
          },
          "expr": "count_over_time({app=\"redis\", service=\"search-api\"} |~ \"MASTER aborted|Disconnected from MASTER|replication\" [1m]) > 0",
          "for": "1m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "critical",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        },
        {
          "alert": "search-api_redis_RedisSlowlog",
          "annotations": {
            "description": "Slow Redis commands detected. Review command patterns and consider optim...",
            "summary": "[search-api/redis] Redis slow commands detected"
          },
          "expr": "sum(count_over_time({app=\"redis\", service=\"search-api\"} |~ \"Slow|slowlog\" [5m])) > 10",
          "for": "5m",
          "labels": {
            "dependency": "redis",
            "service": "search-api",
            "severity": "warning",
            "source": "dependency",
            "team": "search",
            "technology": "redis",
            "tier": "high"
          }
        }
      ]
    }
  ]
}
