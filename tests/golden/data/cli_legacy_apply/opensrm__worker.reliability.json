    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "email-sender_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"email-sender\"}[30d]))",
              "labels": {
                "service": "email-sender",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"email-sender\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "email-sender",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"email-sender\",slo=\"availability\"} / slo:requests_total:30d{service=\"email-sender\",slo=\"availability\"}",
              "labels": {
                "objective": "99.9",
                "service": "email-sender",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"email-sender\",slo=\"availability\"}) / (1 - 0.9990000000000001))",
              "labels": {
                "objective": "99.9",
                "service": "email-sender",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"email-sender\"}[5m]))",
              "labels": {
                "minimum": "100.0",
                "service": "email-sender",
                "slo": "throughput"
              },
              "record": "slo:throughput:rate5m"
            },
            {
              "expr": "(slo:throughput:rate5m{service=\"email-sender\",slo=\"throughput\"} >= 100.0) or vector(0)",
              "labels": {
                "minimum": "100.0",
                "service": "email-sender",
                "slo": "throughput"
              },
              "record": "slo:throughput:compliance"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"email-sender\"}[7d]))",
              "labels": {
                "service": "email-sender",
                "slo": "error_rate"
              },
              "record": "slo:error_requests_total:7d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"email-sender\",status=~\"5..\"}[7d]))",
              "labels": {
                "service": "email-sender",
                "slo": "error_rate"
              },
              "record": "slo:error_requests_failed:7d"
            },
            {
              "expr": "slo:error_requests_failed:7d{service=\"email-sender\",slo=\"error_rate\"} / slo:error_requests_total:7d{service=\"email-sender\",slo=\"error_rate\"}",
              "labels": {
                "objective": "0.5",
                "service": "email-sender",
                "slo": "error_rate"
              },
              "record": "slo:error_rate:ratio"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "email-sender_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(http_requests_total{service=\"email-sender\"}[5m]))",
              "labels": {
                "service": "email-sender"
              },
              "record": "service:http_requests:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"email-sender\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"email-sender\"}[5m]))",
              "labels": {
                "service": "email-sender"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"email-sender\"}[5m]))",
              "labels": {
                "service": "email-sender"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"email-sender\"}[5m]))",
              "labels": {
                "service": "email-sender"
              },
              "record": "service:http_request_duration_seconds:p99"
            }
          ]
        }
      ]
