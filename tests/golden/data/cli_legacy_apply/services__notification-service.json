    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "notification-service_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"notification-service\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"notification-service\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"notification-service\",slo=\"job-success-rate\"} / slo:requests_total:30d{service=\"notification-service\",slo=\"job-success-rate\"}",
              "labels": {
                "objective": "99.5",
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"notification-service\",slo=\"job-success-rate\"}) / (1 - 0.995))",
              "labels": {
                "objective": "99.5",
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"notification-service\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "processing-time-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"notification-service\",le=\"5.0\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "processing-time-p95",
                "threshold": "5000ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"notification-service\",slo=\"processing-time-p95\"} / slo:latency_requests_total:30d{service=\"notification-service\",slo=\"processing-time-p95\"}",
              "labels": {
                "objective": "95.0",
                "service": "notification-service",
                "slo": "processing-time-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service",
                "slo": "processing-time-p95"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service",
                "slo": "processing-time-p95"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service",
                "slo": "processing-time-p95"
              },
              "record": "slo:http_request_duration_seconds:p99"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "notification-service_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(http_requests_total{service=\"notification-service\"}[5m]))",
