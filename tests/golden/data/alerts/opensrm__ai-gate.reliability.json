{
  "groups": [
    {
      "name": "fraud-detector-judgment_threshold",
      "rules": [
        {
          "alert": "AIGateCalibrationECEBreach",
          "annotations": {
            "description": "ai_gate:calibration:ece is {{ $value }}, above the declared maximum_expected_calibration_error of 0.05 (OPENSRM-CORE-v2 §5.5.6 E1).",
            "summary": "fraud-detector: calibration maximum_expected_calibration_error breached"
          },
          "expr": "ai_gate:calibration:ece{service=\"fraud-detector\",target=\"0.05\"} > 0.05",
          "for": "15m",
          "labels": {
            "bound": "maximum_expected_calibration_error",
            "routing": "self",
            "service": "fraud-detector",
            "severity": "warning",
            "team": "risk",
            "threshold_type": "calibration",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateCalibrationECENotEvaluable",
          "annotations": {
            "description": "ai_gate:calibration:ece has no value or is NaN, so maximum_expected_calibration_error cannot be evaluated. Not evaluable is not within bounds (OPENSRM-CORE-v2 §5.5.6 E3).",
            "summary": "fraud-detector: calibration maximum_expected_calibration_error not evaluable"
          },
          "expr": "absent(ai_gate:calibration:ece{service=\"fraud-detector\",target=\"0.05\"}) or (ai_gate:calibration:ece{service=\"fraud-detector\",target=\"0.05\"} != ai_gate:calibration:ece{service=\"fraud-detector\",target=\"0.05\"})",
          "for": "1h",
          "labels": {
            "bound": "maximum_expected_calibration_error",
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "team": "risk",
            "threshold_type": "calibration",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP50Breach",
          "annotations": {
            "description": "Only {{ $value }} of ground truth arrived within 3600.0s, below 0.5, so the quantile exceeds the declared maximum_p50 (OPENSRM-CORE-v2 §5.5.6 E1).",
            "summary": "fraud-detector: feedback_latency maximum_p50 breached"
          },
          "expr": "ai_gate:feedback_latency:p50_within_bound_30d{service=\"fraud-detector\",target=\"3600.0\"} < 0.5",
          "for": "15m",
          "labels": {
            "bound": "maximum_p50",
            "routing": "self",
            "service": "fraud-detector",
            "severity": "warning",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP50NotEvaluable",
          "annotations": {
            "description": "ai_gate:feedback_latency:p50_within_bound_30d has no value or is NaN, so maximum_p50 cannot be evaluated. Not evaluable is not within bounds (OPENSRM-CORE-v2 §5.5.6 E3).",
            "summary": "fraud-detector: feedback_latency maximum_p50 not evaluable"
          },
          "expr": "absent(ai_gate:feedback_latency:p50_within_bound_30d{service=\"fraud-detector\",target=\"3600.0\"}) or (ai_gate:feedback_latency:p50_within_bound_30d{service=\"fraud-detector\",target=\"3600.0\"} != ai_gate:feedback_latency:p50_within_bound_30d{service=\"fraud-detector\",target=\"3600.0\"})",
          "for": "1h",
          "labels": {
            "bound": "maximum_p50",
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        }
      ]
    },
    {
      "name": "fraud-detector-slo",
      "rules": [
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "fraud-detector: SLO availability not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"fraud-detector\",slo=\"availability\"}) or (slo:availability:ratio{service=\"fraud-detector\",slo=\"availability\"} != slo:availability:ratio{service=\"fraud-detector\",slo=\"availability\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "slo": "availability",
            "team": "risk",
            "tier": "critical"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:latency:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "fraud-detector: SLO latency not evaluable"
          },
          "expr": "absent(slo:latency:ratio{service=\"fraud-detector\",slo=\"latency\"}) or (slo:latency:ratio{service=\"fraud-detector\",slo=\"latency\"} != slo:latency:ratio{service=\"fraud-detector\",slo=\"latency\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "slo": "latency",
            "team": "risk",
            "tier": "critical"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "ai_gate:reversal_rate:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "fraud-detector: SLO reversal_rate not evaluable"
          },
          "expr": "absent(ai_gate:reversal_rate:ratio{service=\"fraud-detector\"}) or (ai_gate:reversal_rate:ratio{service=\"fraud-detector\"} != ai_gate:reversal_rate:ratio{service=\"fraud-detector\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "slo": "reversal_rate",
            "team": "risk",
            "tier": "critical"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "ai_gate:high_confidence_failure:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "fraud-detector: SLO high_confidence_failure not evaluable"
          },
          "expr": "absent(ai_gate:high_confidence_failure:ratio{service=\"fraud-detector\"}) or (ai_gate:high_confidence_failure:ratio{service=\"fraud-detector\"} != ai_gate:high_confidence_failure:ratio{service=\"fraud-detector\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "fraud-detector",
            "severity": "info",
            "slo": "high_confidence_failure",
            "team": "risk",
            "tier": "critical"
          }
        }
      ]
    }
  ]
}
