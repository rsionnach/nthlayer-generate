{
  "exit": 0,
  "files": {
    "loki-alerts.yaml": {
      "groups": [
        {
          "name": "admin-dashboard-api",
          "rules": [
            {
              "alert": "admin-dashboard-api_ApplicationError",
              "annotations": {
                "description": "Error-level log entries detected in application logs.",
                "summary": "[admin-dashboard-api] Application errors detected"
              },
              "expr": "sum(count_over_time({app=\"admin-dashboard-api\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
              "for": "5m",
              "labels": {
                "service": "admin-dashboard-api",
                "severity": "warning",
                "source": "service",
                "team": "platform",
                "technology": "api",
                "tier": "standard"
              }
            },
            {
              "alert": "admin-dashboard-api_ApplicationHighErrorRate",
              "annotations": {
                "description": "Application is experiencing a high rate of errors.",
                "summary": "[admin-dashboard-api] High error rate in application"
              },
              "expr": "sum(count_over_time({app=\"admin-dashboard-api\"} |~ \"(?i)error|exception\" [5m])) > 100",
              "for": "5m",
              "labels": {
                "service": "admin-dashboard-api",
                "severity": "critical",
                "source": "service",
                "team": "platform",
                "technology": "api",
                "tier": "standard"
              }
            },
            {
              "alert": "admin-dashboard-api_ApplicationPanic",
              "annotations": {
                "description": "Application appears to have crashed or panicked.",
                "summary": "[admin-dashboard-api] Application panic/crash detected"
              },
              "expr": "count_over_time({app=\"admin-dashboard-api\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "service": "admin-dashboard-api",
                "severity": "critical",
                "source": "service",
                "team": "platform",
                "technology": "api",
                "tier": "standard"
              }
            }
          ]
        }
      ]
    }
  }
}
