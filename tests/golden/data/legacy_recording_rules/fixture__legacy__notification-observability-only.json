{
  "groups": [
    {
      "interval": "30s",
      "name": "notification-observability-only_slo_metrics",
      "rules": [
        {
          "expr": "sum(increase(http_requests_total{service=\"notification-observability-only\"}[30d]))",
          "labels": {
            "service": "notification-observability-only",
            "slo": "delivery-success"
          },
          "record": "slo:error_requests_total:30d"
        },
        {
          "expr": "sum(increase(http_requests_total{service=\"notification-observability-only\",status=~\"5..\"}[30d]))",
          "labels": {
            "service": "notification-observability-only",
            "slo": "delivery-success"
          },
          "record": "slo:error_requests_failed:30d"
        },
        {
          "expr": "slo:error_requests_failed:30d{service=\"notification-observability-only\",slo=\"delivery-success\"} / slo:error_requests_total:30d{service=\"notification-observability-only\",slo=\"delivery-success\"}",
          "labels": {
            "objective": "99.5",
            "service": "notification-observability-only",
            "slo": "delivery-success"
          },
          "record": "slo:error_rate:ratio"
        }
      ]
    },
    {
      "interval": "30s",
      "name": "notification-observability-only_health_metrics",
      "rules": [
        {
          "expr": "sum(rate(http_requests_total{service=\"notification-observability-only\"}[5m]))",
          "labels": {
            "service": "notification-observability-only"
          },
          "record": "service:http_requests:rate5m"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"notification-observability-only\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"notification-observability-only\"}[5m]))",
          "labels": {
            "service": "notification-observability-only"
          },
          "record": "service:http_errors:rate5m"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"notification-observability-only\"}[5m]))",
          "labels": {
            "service": "notification-observability-only"
          },
          "record": "service:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"notification-observability-only\"}[5m]))",
          "labels": {
            "service": "notification-observability-only"
          },
          "record": "service:http_request_duration_seconds:p99"
        }
      ]
    }
  ]
}
