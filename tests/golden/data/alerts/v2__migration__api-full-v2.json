{
  "groups": [
    {
      "name": "payment-api-slo",
      "rules": [
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "payment-api: SLO payment-api-availability not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"payment-api\",slo=\"payment-api-availability\"}) or (slo:availability:ratio{service=\"payment-api\",slo=\"payment-api-availability\"} != slo:availability:ratio{service=\"payment-api\",slo=\"payment-api-availability\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "payment-api",
            "severity": "info",
            "slo": "payment-api-availability",
            "team": "payments",
            "tier": "critical"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:latency:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
