{
  "groups": [
    {
      "name": "email-sender-slo",
      "rules": [
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "email-sender: SLO availability not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"email-sender\",slo=\"availability\"}) or (slo:availability:ratio{service=\"email-sender\",slo=\"availability\"} != slo:availability:ratio{service=\"email-sender\",slo=\"availability\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "email-sender",
            "severity": "info",
            "slo": "availability",
            "team": "notifications",
            "tier": "standard"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:throughput:compliance has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "email-sender: SLO throughput not evaluable"
          },
          "expr": "absent(slo:throughput:compliance{service=\"email-sender\",slo=\"throughput\"}) or (slo:throughput:compliance{service=\"email-sender\",slo=\"throughput\"} != slo:throughput:compliance{service=\"email-sender\",slo=\"throughput\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "email-sender",
            "severity": "info",
            "slo": "throughput",
            "team": "notifications",
            "tier": "standard"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:error_rate:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "email-sender: SLO error_rate not evaluable"
          },
          "expr": "absent(slo:error_rate:ratio{service=\"email-sender\",slo=\"error_rate\"}) or (slo:error_rate:ratio{service=\"email-sender\",slo=\"error_rate\"} != slo:error_rate:ratio{service=\"email-sender\",slo=\"error_rate\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "email-sender",
            "severity": "info",
            "slo": "error_rate",
            "team": "notifications",
            "tier": "standard"
          }
        }
      ]
    }
  ]
}
