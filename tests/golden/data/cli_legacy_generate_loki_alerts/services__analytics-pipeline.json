    "loki-alerts.yaml": {
      "groups": [
        {
          "name": "analytics-pipeline",
          "rules": [
            {
              "alert": "analytics-pipeline_ApplicationError",
              "annotations": {
                "description": "Error-level log entries detected in application logs.",
                "summary": "[analytics-pipeline] Application errors detected"
              },
              "expr": "sum(count_over_time({app=\"analytics-pipeline\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
              "for": "5m",
              "labels": {
                "service": "analytics-pipeline",
                "severity": "warning",
                "source": "service",
                "team": "data",
                "technology": "batch",
                "tier": "standard"
              }
            },
            {
              "alert": "analytics-pipeline_ApplicationHighErrorRate",
              "annotations": {
                "description": "Application is experiencing a high rate of errors.",
                "summary": "[analytics-pipeline] High error rate in application"
              },
              "expr": "sum(count_over_time({app=\"analytics-pipeline\"} |~ \"(?i)error|exception\" [5m])) > 100",
              "for": "5m",
              "labels": {
                "service": "analytics-pipeline",
                "severity": "critical",
                "source": "service",
                "team": "data",
                "technology": "batch",
                "tier": "standard"
              }
            },
            {
              "alert": "analytics-pipeline_ApplicationPanic",
              "annotations": {
                "description": "Application appears to have crashed or panicked.",
                "summary": "[analytics-pipeline] Application panic/crash detected"
              },
              "expr": "count_over_time({app=\"analytics-pipeline\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "service": "analytics-pipeline",
