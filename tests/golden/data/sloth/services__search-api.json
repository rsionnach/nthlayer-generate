{
  "labels": {
    "team": "search",
    "tier": "high",
    "type": "api"
  },
  "service": "search-api",
  "slos": [
    {
      "alerting": {
        "annotations": {
          "summary": "SLO search-availability for search-api"
        },
        "labels": {
          "service": "search-api",
          "tier": "high"
        },
        "name": "SearchApiSearchAvailability",
        "ticket_alert": {
          "annotations": {
            "summary": "Error budget burn on search-api"
          },
          "labels": {
            "severity": "warning"
          }
        }
      },
      "description": "99.5% search availability",
      "name": "search-availability",
      "objective": 99.5,
      "sli": {
        "events": {
          "error_query": "sum(rate(http_requests_total{service=\"search-api\",status!~\"5..\"}[5m]))",
          "total_query": "sum(rate(http_requests_total{service=\"search-api\"}[5m]))"
        }
      }
    },
    {
      "alerting": {
        "annotations": {
          "summary": "SLO search-latency-p95 for search-api"
        },
        "labels": {
          "service": "search-api",
          "tier": "high"
        },
        "name": "SearchApiSearchLatencyP95",
        "ticket_alert": {
          "annotations": {
            "summary": "Error budget burn on search-api"
          },
          "labels": {
            "severity": "warning"
          }
        }
      },
      "description": "99.0% search latency p95",
      "name": "search-latency-p95",
      "objective": 99.0,
      "sli": {
        "events": {
          "error_query": "histogram_quantile(0.95,\n  rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m])\n)\n > 0.3",
          "total_query": "sum(rate(0.95,\n  rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m])\n)\n)"
        }
      }
    }
  ],
  "version": "prometheus/v1"
}
