{
  "groups": [
    {
      "name": "credit-decision-agent-judgment_threshold",
      "rules": [
        {
          "alert": "AIGateCalibrationBrierBreach",
          "annotations": {
            "description": "ai_gate:calibration:brier is {{ $value }}, above the declared maximum_brier_score of 0.05 (OPENSRM-CORE-v2 §5.5.6 E1).",
            "summary": "credit-decision-agent: calibration maximum_brier_score breached"
          },
          "expr": "ai_gate:calibration:brier{service=\"credit-decision-agent\",target=\"0.05\"} > 0.05",
          "for": "15m",
          "labels": {
            "bound": "maximum_brier_score",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "warning",
            "team": "risk",
            "threshold_type": "calibration",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateCalibrationBrierNotEvaluable",
          "annotations": {
            "description": "ai_gate:calibration:brier has no value, so maximum_brier_score cannot be evaluated. Not evaluable is not within bounds (OPENSRM-CORE-v2 §5.5.6 E3).",
            "summary": "credit-decision-agent: calibration maximum_brier_score not evaluable"
          },
          "expr": "absent(ai_gate:calibration:brier{service=\"credit-decision-agent\",target=\"0.05\"}) or (ai_gate:calibration:brier{service=\"credit-decision-agent\",target=\"0.05\"} != ai_gate:calibration:brier{service=\"credit-decision-agent\",target=\"0.05\"})",
          "for": "1h",
          "labels": {
            "bound": "maximum_brier_score",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "info",
            "team": "risk",
            "threshold_type": "calibration",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP50Breach",
          "annotations": {
            "description": "Only {{ $value }} of ground truth arrived within 3600.0s, below 0.5, so the quantile exceeds the declared maximum_p50 (OPENSRM-CORE-v2 §5.5.6 E1).",
            "summary": "credit-decision-agent: feedback_latency maximum_p50 breached"
          },
          "expr": "ai_gate:feedback_latency:p50_within_bound_30d{service=\"credit-decision-agent\",target=\"3600.0\"} < 0.5",
          "for": "15m",
          "labels": {
            "bound": "maximum_p50",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "warning",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP50NotEvaluable",
          "annotations": {
            "description": "ai_gate:feedback_latency:p50_within_bound_30d has no value, so maximum_p50 cannot be evaluated. Not evaluable is not within bounds (OPENSRM-CORE-v2 §5.5.6 E3).",
            "summary": "credit-decision-agent: feedback_latency maximum_p50 not evaluable"
          },
          "expr": "absent(ai_gate:feedback_latency:p50_within_bound_30d{service=\"credit-decision-agent\",target=\"3600.0\"}) or (ai_gate:feedback_latency:p50_within_bound_30d{service=\"credit-decision-agent\",target=\"3600.0\"} != ai_gate:feedback_latency:p50_within_bound_30d{service=\"credit-decision-agent\",target=\"3600.0\"})",
          "for": "1h",
          "labels": {
            "bound": "maximum_p50",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "info",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP90Breach",
          "annotations": {
            "description": "Only {{ $value }} of ground truth arrived within 86400.0s, below 0.9, so the quantile exceeds the declared maximum_p90 (OPENSRM-CORE-v2 §5.5.6 E1).",
            "summary": "credit-decision-agent: feedback_latency maximum_p90 breached"
          },
          "expr": "ai_gate:feedback_latency:p90_within_bound_30d{service=\"credit-decision-agent\",target=\"86400.0\"} < 0.9",
          "for": "15m",
          "labels": {
            "bound": "maximum_p90",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "warning",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        },
        {
          "alert": "AIGateFeedbackLatencyP90NotEvaluable",
          "annotations": {
            "description": "ai_gate:feedback_latency:p90_within_bound_30d has no value, so maximum_p90 cannot be evaluated. Not evaluable is not within bounds (OPENSRM-CORE-v2 §5.5.6 E3).",
            "summary": "credit-decision-agent: feedback_latency maximum_p90 not evaluable"
          },
          "expr": "absent(ai_gate:feedback_latency:p90_within_bound_30d{service=\"credit-decision-agent\",target=\"86400.0\"}) or (ai_gate:feedback_latency:p90_within_bound_30d{service=\"credit-decision-agent\",target=\"86400.0\"} != ai_gate:feedback_latency:p90_within_bound_30d{service=\"credit-decision-agent\",target=\"86400.0\"})",
          "for": "1h",
          "labels": {
            "bound": "maximum_p90",
            "routing": "self",
            "service": "credit-decision-agent",
            "severity": "info",
            "team": "risk",
            "threshold_type": "feedback_latency",
            "tier": "critical"
          }
        }
      ]
    }
  ]
}
