{
  "groups": [
    {
      "name": "batch-reports-postgresql",
      "rules": [
        {
          "alert": "PostgresqlDown",
          "annotations": {
            "description": "Postgresql instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql down (instance {{ $labels.instance }})"
          },
          "expr": "pg_up == 0",
          "for": "1m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "PostgresqlRestarted",
          "annotations": {
            "description": "Postgresql restarted\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql restarted (instance {{ $labels.instance }})"
          },
          "expr": "time() - pg_postmaster_start_time_seconds < 60",
          "for": "1m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "PostgresqlExporterError",
          "annotations": {
            "description": "Postgresql exporter is showing errors. A query may be buggy in query.yaml\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql exporter error (instance {{ $labels.instance }})"
          },
          "expr": "pg_exporter_last_scrape_error > 0",
          "for": "1m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "PostgresqlCommitRateLow",
          "annotations": {
            "description": "Postgresql seems to be processing very few transactions\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql commit rate low (instance {{ $labels.instance }})"
          },
          "expr": "rate(pg_stat_database_xact_commit[1m]) < 10",
          "for": "2m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "PostgresqlHighRateStatementTimeout",
          "annotations": {
            "description": "Postgres transactions are showing high rate of statement timeouts\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql high rate statement timeout (instance {{ $labels.instance }})"
          },
          "expr": "rate(postgresql_errors_total{type=\"statement_timeout\"}[1m]) > 3",
          "for": "1m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "PostgresqlHighRateDeadlock",
          "annotations": {
            "description": "Postgres detected deadlocks\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
            "summary": "Postgresql high rate deadlock (instance {{ $labels.instance }})"
          },
          "expr": "increase(postgresql_errors_total{type=\"deadlock_detected\"}[1m]) > 1",
          "for": "1m",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "critical",
            "team": "data",
            "tier": "low"
          }
        }
      ]
    },
    {
      "name": "batch-reports-slo",
      "rules": [
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "batch-reports: SLO availability not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"batch-reports\",slo=\"availability\"}) or (slo:availability:ratio{service=\"batch-reports\",slo=\"availability\"} != slo:availability:ratio{service=\"batch-reports\",slo=\"availability\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "info",
            "slo": "availability",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:latency:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "batch-reports: SLO latency-p95 not evaluable"
          },
          "expr": "absent(slo:latency:ratio{service=\"batch-reports\",slo=\"latency-p95\"}) or (slo:latency:ratio{service=\"batch-reports\",slo=\"latency-p95\"} != slo:latency:ratio{service=\"batch-reports\",slo=\"latency-p95\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "info",
            "slo": "latency-p95",
            "team": "data",
            "tier": "low"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "batch-reports: SLO report-success-rate not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"batch-reports\",slo=\"report-success-rate\"}) or (slo:availability:ratio{service=\"batch-reports\",slo=\"report-success-rate\"} != slo:availability:ratio{service=\"batch-reports\",slo=\"report-success-rate\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "batch-reports",
            "severity": "info",
            "slo": "report-success-rate",
            "team": "data",
            "tier": "low"
          }
        }
      ]
    }
  ]
}
