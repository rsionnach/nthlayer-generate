{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "batch-reports_health_metrics",
          "rules": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports"
              },
              "record": "service:http_request_duration_seconds:p99"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"batch-reports\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports"
              },
              "record": "service:http_requests:rate5m"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "batch-reports_slo_metrics",
          "rules": [
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"batch-reports\",slo=\"availability\"}) / (1 - 0.99))",
              "labels": {
                "objective": "99.0",
                "service": "batch-reports",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m]))",
              "labels": {
                "service": "batch-reports",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "slo:error_requests_failed:30d{service=\"batch-reports\",slo=\"report-success-rate\"} / slo:error_requests_total:30d{service=\"batch-reports\",slo=\"report-success-rate\"}",
              "labels": {
                "objective": "95.0",
                "service": "batch-reports",
                "slo": "report-success-rate"
              },
              "record": "slo:error_rate:ratio"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"batch-reports\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"batch-reports\",slo=\"latency-p95\"}",
              "labels": {
                "objective": "90.0",
                "service": "batch-reports",
                "slo": "latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:requests_success:30d{service=\"batch-reports\",slo=\"availability\"} / slo:requests_total:30d{service=\"batch-reports\",slo=\"availability\"}",
              "labels": {
                "objective": "99.0",
                "service": "batch-reports",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"batch-reports\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "latency-p95",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"batch-reports\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"batch-reports\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"batch-reports\",status=~\"5..\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "report-success-rate"
              },
              "record": "slo:error_requests_failed:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"batch-reports\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"batch-reports\"}[30d]))",
              "labels": {
                "service": "batch-reports",
                "slo": "report-success-rate"
              },
              "record": "slo:error_requests_total:30d"
            }
          ]
        }
      ]
    }
  }
}
