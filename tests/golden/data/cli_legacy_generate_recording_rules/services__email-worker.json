{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "email-worker_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"email-worker\"}[30d]))",
              "labels": {
                "service": "email-worker",
                "slo": "success-rate"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"email-worker\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "email-worker",
                "slo": "success-rate"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"email-worker\",slo=\"success-rate\"} / slo:requests_total:30d{service=\"email-worker\",slo=\"success-rate\"}",
              "labels": {
                "objective": "99.0",
                "service": "email-worker",
                "slo": "success-rate"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"email-worker\",slo=\"success-rate\"}) / (1 - 0.99))",
              "labels": {
                "objective": "99.0",
                "service": "email-worker",
                "slo": "success-rate"
              },
              "record": "slo:error_budget_remaining:ratio"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "email-worker_health_metrics",
          "rules": [
            {
              "expr": "sum(rate(http_requests_total{service=\"email-worker\"}[5m]))",
              "labels": {
                "service": "email-worker"
              },
              "record": "service:http_requests:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"email-worker\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"email-worker\"}[5m]))",
              "labels": {
                "service": "email-worker"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"email-worker\"}[5m]))",
              "labels": {
                "service": "email-worker"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"email-worker\"}[5m]))",
              "labels": {
                "service": "email-worker"
              },
              "record": "service:http_request_duration_seconds:p99"
            }
          ]
        }
      ]
    }
  },
