{
  "groups": [
    {
      "interval": "30s",
      "name": "checkout-service_slo_metrics",
      "rules": [
        {
          "expr": "sum(increase(http_requests_total{service=\"checkout-service\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "availability"
          },
          "record": "slo:requests_total:30d"
        },
        {
          "expr": "sum(increase(http_requests_total{service=\"checkout-service\",status!~\"5..\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "availability"
          },
          "record": "slo:requests_success:30d"
        },
        {
          "expr": "slo:requests_success:30d{service=\"checkout-service\",slo=\"availability\"} / slo:requests_total:30d{service=\"checkout-service\",slo=\"availability\"}",
          "labels": {
            "objective": "99.95",
            "service": "checkout-service",
            "slo": "availability"
          },
          "record": "slo:availability:ratio"
        },
        {
          "expr": "1 - ((1 - slo:availability:ratio{service=\"checkout-service\",slo=\"availability\"}) / (1 - 0.9995))",
          "labels": {
            "objective": "99.95",
            "service": "checkout-service",
            "slo": "availability"
          },
          "record": "slo:error_budget_remaining:ratio"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_count{service=\"checkout-service\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p95"
          },
          "record": "slo:latency_requests_total:30d"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"checkout-service\",le=\"0.5\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p95",
            "threshold": "500ms"
          },
          "record": "slo:latency_requests_fast:30d"
        },
        {
          "expr": "slo:latency_requests_fast:30d{service=\"checkout-service\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"checkout-service\",slo=\"latency-p95\"}",
          "labels": {
            "objective": "99.0",
            "service": "checkout-service",
            "slo": "latency-p95"
          },
          "record": "slo:latency:ratio"
        },
        {
          "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p95"
          },
          "record": "slo:http_request_duration_seconds:p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p95"
          },
          "record": "slo:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p95"
          },
          "record": "slo:http_request_duration_seconds:p99"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_count{service=\"checkout-service\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p99"
          },
          "record": "slo:latency_requests_total:30d"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"checkout-service\",le=\"0.5\"}[30d]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p99",
            "threshold": "500ms"
          },
          "record": "slo:latency_requests_fast:30d"
        },
        {
          "expr": "slo:latency_requests_fast:30d{service=\"checkout-service\",slo=\"latency-p99\"} / slo:latency_requests_total:30d{service=\"checkout-service\",slo=\"latency-p99\"}",
          "labels": {
            "objective": "95.0",
            "service": "checkout-service",
            "slo": "latency-p99"
          },
          "record": "slo:latency:ratio"
        },
        {
          "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p99"
          },
          "record": "slo:http_request_duration_seconds:p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p99"
          },
          "record": "slo:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service",
            "slo": "latency-p99"
          },
          "record": "slo:http_request_duration_seconds:p99"
        }
      ]
    },
    {
      "interval": "30s",
      "name": "checkout-service_health_metrics",
      "rules": [
        {
          "expr": "sum(rate(http_requests_total{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service"
          },
          "record": "service:http_requests:rate5m"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"checkout-service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service"
          },
          "record": "service:http_errors:rate5m"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service"
          },
          "record": "service:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-service\"}[5m]))",
          "labels": {
            "service": "checkout-service"
          },
          "record": "service:http_request_duration_seconds:p99"
        }
      ]
    }
  ]
}
