{
  "groups": [
    {
      "interval": "30s",
      "name": "checkout-env-vars_slo_metrics",
      "rules": [
        {
          "expr": "sum(increase(http_requests_total{service=\"checkout-env-vars\"}[30d]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "availability-prod"
          },
          "record": "slo:requests_total:30d"
        },
        {
          "expr": "sum(increase(http_requests_total{service=\"checkout-env-vars\",status!~\"5..\"}[30d]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "availability-prod"
          },
          "record": "slo:requests_success:30d"
        },
        {
          "expr": "slo:requests_success:30d{service=\"checkout-env-vars\",slo=\"availability-prod\"} / slo:requests_total:30d{service=\"checkout-env-vars\",slo=\"availability-prod\"}",
          "labels": {
            "objective": "99.99",
            "service": "checkout-env-vars",
            "slo": "availability-prod"
          },
          "record": "slo:availability:ratio"
        },
        {
          "expr": "1 - ((1 - slo:availability:ratio{service=\"checkout-env-vars\",slo=\"availability-prod\"}) / (1 - 0.9998999999999999))",
          "labels": {
            "objective": "99.99",
            "service": "checkout-env-vars",
            "slo": "availability-prod"
          },
          "record": "slo:error_budget_remaining:ratio"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_count{service=\"checkout-env-vars\"}[30d]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce"
          },
          "record": "slo:latency_requests_total:30d"
        },
        {
          "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"checkout-env-vars\",le=\"0.5\"}[30d]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce",
            "threshold": "500ms"
          },
          "record": "slo:latency_requests_fast:30d"
        },
        {
          "expr": "slo:latency_requests_fast:30d{service=\"checkout-env-vars\",slo=\"latency-p95-commerce\"} / slo:latency_requests_total:30d{service=\"checkout-env-vars\",slo=\"latency-p95-commerce\"}",
          "labels": {
            "objective": "99.0",
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce"
          },
          "record": "slo:latency:ratio"
        },
        {
          "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce"
          },
          "record": "slo:http_request_duration_seconds:p50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce"
          },
          "record": "slo:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars",
            "slo": "latency-p95-commerce"
          },
          "record": "slo:http_request_duration_seconds:p99"
        }
      ]
    },
    {
      "interval": "30s",
      "name": "checkout-env-vars_health_metrics",
      "rules": [
        {
          "expr": "sum(rate(http_requests_total{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars"
          },
          "record": "service:http_requests:rate5m"
        },
        {
          "expr": "sum(rate(http_requests_total{service=\"checkout-env-vars\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars"
          },
          "record": "service:http_errors:rate5m"
        },
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars"
          },
          "record": "service:http_request_duration_seconds:p95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"checkout-env-vars\"}[5m]))",
          "labels": {
            "service": "checkout-env-vars"
          },
          "record": "service:http_request_duration_seconds:p99"
        }
      ]
    }
  ]
}
