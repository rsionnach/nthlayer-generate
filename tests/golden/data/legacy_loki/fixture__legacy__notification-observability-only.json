{
  "count": 3,
  "file": {
    "groups": [
      {
        "name": "notification-observability-only",
        "rules": [
          {
            "alert": "notification-observability-only_ApplicationError",
            "annotations": {
              "description": "Error-level log entries detected in application logs.",
              "summary": "[notification-observability-only] Application errors detected"
            },
            "expr": "sum(count_over_time({app=\"notification-observability-only\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
            "for": "5m",
            "labels": {
              "service": "notification-observability-only",
              "severity": "warning",
              "source": "service",
              "team": "platform",
              "technology": "worker",
              "tier": "high"
            }
          },
          {
            "alert": "notification-observability-only_ApplicationHighErrorRate",
            "annotations": {
              "description": "Application is experiencing a high rate of errors.",
              "summary": "[notification-observability-only] High error rate in application"
            },
            "expr": "sum(count_over_time({app=\"notification-observability-only\"} |~ \"(?i)error|exception\" [5m])) > 100",
            "for": "5m",
            "labels": {
              "service": "notification-observability-only",
              "severity": "critical",
              "source": "service",
              "team": "platform",
              "technology": "worker",
              "tier": "high"
            }
          },
          {
            "alert": "notification-observability-only_ApplicationPanic",
            "annotations": {
              "description": "Application appears to have crashed or panicked.",
              "summary": "[notification-observability-only] Application panic/crash detected"
            },
            "expr": "count_over_time({app=\"notification-observability-only\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "service": "notification-observability-only",
              "severity": "critical",
              "source": "service",
              "team": "platform",
              "technology": "worker",
              "tier": "high"
            }
          }
        ]
      }
    ]
  }
}
