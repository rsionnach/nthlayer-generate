{
  "count": 10,
  "file": {
    "groups": [
      {
        "name": "payment-api",
        "rules": [
          {
            "alert": "payment-api_ApplicationError",
            "annotations": {
              "description": "Error-level log entries detected in application logs.",
              "summary": "[payment-api] Application errors detected"
            },
            "expr": "sum(count_over_time({app=\"payment-api\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
            "for": "5m",
            "labels": {
              "service": "payment-api",
              "severity": "warning",
              "source": "service",
              "team": "payments",
              "technology": "api",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_ApplicationHighErrorRate",
            "annotations": {
              "description": "Application is experiencing a high rate of errors.",
              "summary": "[payment-api] High error rate in application"
            },
            "expr": "sum(count_over_time({app=\"payment-api\"} |~ \"(?i)error|exception\" [5m])) > 100",
            "for": "5m",
            "labels": {
              "service": "payment-api",
              "severity": "critical",
              "source": "service",
              "team": "payments",
              "technology": "api",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_ApplicationPanic",
            "annotations": {
              "description": "Application appears to have crashed or panicked.",
              "summary": "[payment-api] Application panic/crash detected"
            },
            "expr": "count_over_time({app=\"payment-api\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "service": "payment-api",
              "severity": "critical",
              "source": "service",
              "team": "payments",
              "technology": "api",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlConnectionRefused",
            "annotations": {
              "description": "Applications are unable to connect to PostgreSQL. Check if the database ...",
              "summary": "[payment-api/postgresql] PostgreSQL connection refused"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |~ \"connection refused|could not connect\" [1m]) > 0",
            "for": "1m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "critical",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlDeadlock",
            "annotations": {
              "description": "A deadlock was detected in PostgreSQL. This may indicate application log...",
              "summary": "[payment-api/postgresql] PostgreSQL deadlock detected"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |= \"deadlock detected\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "warning",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlFatalError",
            "annotations": {
              "description": "PostgreSQL logged a FATAL error which typically indicates a serious issu...",
              "summary": "[payment-api/postgresql] PostgreSQL FATAL error detected"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |= \"FATAL\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "critical",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlOutOfConnections",
            "annotations": {
              "description": "PostgreSQL has reached its maximum connection limit. Consider increasing...",
              "summary": "[payment-api/postgresql] PostgreSQL out of connections"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |= \"too many connections\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "critical",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlPanicError",
            "annotations": {
              "description": "PostgreSQL logged a PANIC error - the database may have crashed or be in...",
              "summary": "[payment-api/postgresql] PostgreSQL PANIC error detected"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |= \"PANIC\" [1m]) > 0",
            "for": "0m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "critical",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlReplicationLag",
            "annotations": {
              "description": "Replication lag detected between primary and replica. Check network and ...",
              "summary": "[payment-api/postgresql] PostgreSQL replication lag detected"
            },
            "expr": "count_over_time({app=\"postgresql\", service=\"payment-api\"} |~ \"replication.*lag|recovery.*behind\" [1m]) > 0",
            "for": "5m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "warning",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          },
          {
            "alert": "payment-api_postgresql_PostgresqlSlowQuery",
            "annotations": {
              "description": "Slow queries (>1s) are being logged. Review query performance and consid...",
              "summary": "[payment-api/postgresql] PostgreSQL slow queries detected"
            },
            "expr": "sum(count_over_time({app=\"postgresql\", service=\"payment-api\"} |= \"duration:\" |~ \"duration: [0-9]{4,}\" [5m])) > 5",
            "for": "5m",
            "labels": {
              "dependency": "postgresql",
              "service": "payment-api",
              "severity": "warning",
              "source": "dependency",
              "team": "payments",
              "technology": "postgresql",
              "tier": "critical"
            }
          }
        ]
      }
    ]
  }
}
