{
  "groups": [
    {
      "name": "daily-report-generator",
      "rules": [
        {
          "alert": "daily-report-generator_ApplicationError",
          "annotations": {
            "description": "Error-level log entries detected in application logs.",
            "summary": "[daily-report-generator] Application errors detected"
          },
          "expr": "sum(count_over_time({app=\"daily-report-generator\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
          "for": "5m",
          "labels": {
            "service": "daily-report-generator",
            "severity": "warning",
            "source": "service",
            "team": "analytics",
            "technology": "batch",
            "tier": "standard"
          }
        },
        {
          "alert": "daily-report-generator_ApplicationHighErrorRate",
          "annotations": {
            "description": "Application is experiencing a high rate of errors.",
            "summary": "[daily-report-generator] High error rate in application"
          },
          "expr": "sum(count_over_time({app=\"daily-report-generator\"} |~ \"(?i)error|exception\" [5m])) > 100",
          "for": "5m",
          "labels": {
            "service": "daily-report-generator",
            "severity": "critical",
            "source": "service",
            "team": "analytics",
            "technology": "batch",
            "tier": "standard"
          }
        },
        {
          "alert": "daily-report-generator_ApplicationPanic",
          "annotations": {
            "description": "Application appears to have crashed or panicked.",
            "summary": "[daily-report-generator] Application panic/crash detected"
          },
          "expr": "count_over_time({app=\"daily-report-generator\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
          "for": "0m",
          "labels": {
            "service": "daily-report-generator",
            "severity": "critical",
            "source": "service",
            "team": "analytics",
            "technology": "batch",
            "tier": "standard"
          }
        },
        {
          "alert": "daily-report-generator_redshift_ApplicationError",
          "annotations": {
            "description": "Error-level log entries detected in application logs.",
            "summary": "[daily-report-generator/redshift] Application errors detected"
          },
