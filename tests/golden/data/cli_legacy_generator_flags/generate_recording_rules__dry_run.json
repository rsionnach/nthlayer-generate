    "  labels:",
    "  service: checkout-service",
    "  slo: availability",
    "  - record: slo:availability:ratio",
    "  expr: slo:requests_success:30d{service=\"checkout-service\",slo=\"availability\"}",
    "  / slo:requests_total:30d{service=\"checkout-service\",slo=\"availability\"}",
    "  labels:",
    "  service: checkout-service",
    "  slo: availability",
    "  objective: '99.95'",
    "  - record: slo:error_budget_remaining:ratio",
    "  expr: 1 - ((1 - slo:availability:ratio{service=\"checkout-service\",slo=\"availability\"})",
    "  / (1 - 0.9995))",
    "  labels:",
    "  service: checkout-service",
    "  slo: availability",
    "  objective: '99.95'",
    "  - record: slo:latency_requests_total:30d",
    "  expr: sum(increase(http_request_duration_seconds_count{service=\"checkout-service\"}[30d]))",
    "  labels:",
    "  service: checkout-service",
    "  slo: latency-p95",
    "  - record: slo:latency_requests_fast:30d",
    "  expr: sum(increase(http_request_duration_seconds_bucket{service=\"checkout-service\",le=\"0.5\"}[30d]))",
    "  labels:",
