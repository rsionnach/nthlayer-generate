    "alerts.yaml": {
      "groups": [
        {
          "name": "analytics-stream-mongodb",
          "rules": [
            {
              "alert": "MongodbCursorsTimeouts",
              "annotations": {
                "description": "Too many cursors are timing out\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB cursors timeouts (instance {{ $labels.instance }})"
              },
              "expr": "increase(mongodb_ss_metrics_cursor_timedOut[1m]) > 100",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbDown",
              "annotations": {
                "description": "MongoDB instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB Down (instance {{ $labels.instance }})"
              },
              "expr": "mongodb_up == 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbNumberCursorsOpen",
              "annotations": {
                "description": "Too many cursors opened by MongoDB for clients (> 10k)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB number cursors open (instance {{ $labels.instance }})"
              },
              "expr": "mongodb_ss_metrics_cursor_open{csr_type=\"total\"} > 10 * 1000",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbReplicaMemberUnhealthy",
              "annotations": {
                "description": "MongoDB replica member is not healthy\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Mongodb replica member unhealthy (instance {{ $labels.instance }})"
              },
              "expr": "mongodb_rs_members_health == 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbReplicationHeadroom",
              "annotations": {
                "description": "MongoDB replication headroom is <= 0\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB replication headroom (instance [instance unavailable])"
              },
              "expr": "sum(avg(mongodb_mongod_replset_oplog_head_timestamp - mongodb_mongod_replset_oplog_tail_timestamp)) - sum(avg(mongodb_rs_members_optimeDate{member_state=\"PRIMARY\"} - on (set) group_right mongodb_rs_members_optimeDate{member_state=\"SECONDARY\"})) <= 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbReplicationLag",
              "annotations": {
                "description": "Mongodb replication lag is more than 10s\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB replication lag (instance {{ $labels.instance }})"
              },
              "expr": "(mongodb_rs_members_optimeDate{member_state=\"PRIMARY\"} - on (set) group_right mongodb_rs_members_optimeDate{member_state=\"SECONDARY\"}) / 1000 > 10",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "MongodbTooManyConnections",
              "annotations": {
                "description": "Too many connections (> 80%)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "MongoDB too many connections (instance {{ $labels.instance }})"
              },
              "expr": "avg by(instance) (rate(mongodb_ss_connections{conn_type=\"current\"}[1m])) / avg by(instance) (sum (mongodb_ss_connections) by (instance)) * 100 > 80",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            }
          ]
        },
        {
          "name": "analytics-stream-redis",
          "rules": [
            {
              "alert": "RedisClusterFlapping",
              "annotations": {
                "description": "Changes have been detected in Redis replica connection. This can occur when replica nodes lose connection to the master and reconnect (a.k.a flapping).\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis cluster flapping (instance {{ $labels.instance }})"
              },
              "expr": "changes(redis_connected_slaves[1m]) > 1",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisDisconnectedSlaves",
              "annotations": {
                "description": "Redis not replicating for all slaves. Consider reviewing the redis replication status.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis disconnected slaves (instance [instance unavailable])"
              },
              "expr": "count without (instance, job) (redis_connected_slaves) - sum without (instance, job) (redis_connected_slaves) - 1 > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisDown",
              "annotations": {
                "description": "Redis instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis down (instance {{ $labels.instance }})"
              },
              "expr": "redis_up == 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisMissingBackup",
              "annotations": {
                "description": "Redis has not been backuped for 24 hours\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis missing backup (instance {{ $labels.instance }})"
              },
              "expr": "time() - redis_rdb_last_save_timestamp_seconds > 60 * 60 * 24",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisMissingMaster",
              "annotations": {
                "description": "Redis cluster has no node marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis missing master (instance [instance unavailable])"
              },
              "expr": "(count(redis_instance_info{role=\"master\"}) or vector(0)) < 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisNotEnoughConnections",
              "annotations": {
                "description": "Redis instance should have more connections (> 5)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis not enough connections (instance {{ $labels.instance }})"
              },
              "expr": "redis_connected_clients < 5",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisOutOfConfiguredMaxmemory",
              "annotations": {
                "description": "Redis is running out of configured maxmemory (> 90%)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis out of configured maxmemory (instance {{ $labels.instance }})"
              },
              "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100 > 90 and on(instance) redis_memory_max_bytes > 0",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisOutOfSystemMemory",
              "annotations": {
                "description": "Redis is running out of system memory (> 90%)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis out of system memory (instance {{ $labels.instance }})"
              },
              "expr": "redis_memory_used_bytes / redis_total_system_memory_bytes * 100 > 90",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisRejectedConnections",
              "annotations": {
                "description": "Some connections to Redis has been rejected\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis rejected connections (instance {{ $labels.instance }})"
              },
              "expr": "increase(redis_rejected_connections_total[1m]) > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisReplicationBroken",
              "annotations": {
                "description": "Redis instance lost a slave\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis replication broken (instance {{ $labels.instance }})"
              },
              "expr": "delta(redis_connected_slaves[1m]) < 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisTooManyConnections",
              "annotations": {
                "description": "Redis is running out of connections (> 90% used)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis too many connections (instance {{ $labels.instance }})"
              },
              "expr": "redis_connected_clients / redis_config_maxclients * 100 > 90",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "warning",
                "team": "data",
                "tier": "high"
              }
            },
            {
              "alert": "RedisTooManyMasters",
              "annotations": {
                "description": "Redis cluster has too many nodes marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis too many masters (instance [instance unavailable])"
              },
              "expr": "count(redis_instance_info{role=\"master\"}) > 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "analytics-stream",
                "severity": "critical",
                "team": "data",
                "tier": "high"
              }
            }
          ]
        }
      ]
    },
