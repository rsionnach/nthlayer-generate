      "groups": [
        {
          "interval": "30s",
          "name": "daily-report-generator_slo_metrics",
          "rules": [
            {
              "expr": "sum(increase(http_requests_total{service=\"daily-report-generator\"}[30d]))",
              "labels": {
                "service": "daily-report-generator",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"daily-report-generator\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "daily-report-generator",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "slo:requests_success:30d{service=\"daily-report-generator\",slo=\"availability\"} / slo:requests_total:30d{service=\"daily-report-generator\",slo=\"availability\"}",
              "labels": {
                "objective": "99.0",
                "service": "daily-report-generator",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"daily-report-generator\",slo=\"availability\"}) / (1 - 0.99))",
              "labels": {
                "objective": "99.0",
                "service": "daily-report-generator",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"daily-report-generator\"}[7d]))",
              "labels": {
                "service": "daily-report-generator",
                "slo": "error_rate"
              },
              "record": "slo:error_requests_total:7d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"daily-report-generator\",status=~\"5..\"}[7d]))",
              "labels": {
                "service": "daily-report-generator",
                "slo": "error_rate"
              },
              "record": "slo:error_requests_failed:7d"
            },
            {
              "expr": "slo:error_requests_failed:7d{service=\"daily-report-generator\",slo=\"error_rate\"} / slo:error_requests_total:7d{service=\"daily-report-generator\",slo=\"error_rate\"}",
              "labels": {
                "objective": "1.0",
                "service": "daily-report-generator",
                "slo": "error_rate"
              },
              "record": "slo:error_rate:ratio"
            }
          ]
        },
        {
          "interval": "30s",
