  "exit": 0,
  "files": {
    "loki-alerts.yaml": {
      "groups": [
        {
          "name": "payment-api",
          "rules": [
            {
              "alert": "payment-api_ApplicationError",
              "annotations": {
                "description": "Error-level log entries detected in application logs.",
                "summary": "[payment-api] Application errors detected"
              },
              "expr": "sum(count_over_time({app=\"payment-api\"} |~ \"(?i)error|exception|fatal\" [5m])) > 10",
              "for": "5m",
              "labels": {
                "service": "payment-api",
                "severity": "warning",
                "source": "service",
                "team": "payments-team",
                "technology": "api",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_ApplicationHighErrorRate",
              "annotations": {
                "description": "Application is experiencing a high rate of errors.",
                "summary": "[payment-api] High error rate in application"
              },
              "expr": "sum(count_over_time({app=\"payment-api\"} |~ \"(?i)error|exception\" [5m])) > 100",
              "for": "5m",
              "labels": {
                "service": "payment-api",
                "severity": "critical",
                "source": "service",
                "team": "payments-team",
                "technology": "api",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_ApplicationPanic",
              "annotations": {
                "description": "Application appears to have crashed or panicked.",
                "summary": "[payment-api] Application panic/crash detected"
              },
              "expr": "count_over_time({app=\"payment-api\"} |~ \"(?i)panic|segfault|SIGSEGV\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "service": "payment-api",
                "severity": "critical",
                "source": "service",
                "team": "payments-team",
                "technology": "api",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaAuthenticationFailure",
              "annotations": {
                "description": "Authentication failures detected when connecting to Kafka.",
                "summary": "[payment-api/kafka] Kafka authentication failures"
              },
              "expr": "sum(count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"authentication.*fail|AuthenticationException|SASL\" [5m])) > 5",
              "for": "5m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "warning",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaBrokerDown",
              "annotations": {
                "description": "A Kafka broker appears to be down or unreachable.",
                "summary": "[payment-api/kafka] Kafka broker down"
              },
              "expr": "count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"broker.*down|BrokerNotAvailable|disconnected\" [1m]) > 0",
              "for": "1m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "critical",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaConsumerLag",
              "annotations": {
                "description": "Consumer group is lagging behind. Messages may not be processed in time.",
                "summary": "[payment-api/kafka] Kafka consumer lag detected"
              },
              "expr": "count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"consumer.*lag|ConsumerLag|offset.*behind\" [1m]) > 0",
              "for": "10m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "warning",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaLeaderElection",
              "annotations": {
                "description": "Kafka is performing leader election. This may cause brief unavailability...",
                "summary": "[payment-api/kafka] Kafka leader election in progress"
              },
              "expr": "count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"leader.*election|LeaderElection|partition.*leader\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "warning",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaOutOfDiskSpace",
              "annotations": {
                "description": "Kafka broker is out of disk space. Immediate action required.",
                "summary": "[payment-api/kafka] Kafka out of disk space"
              },
              "expr": "count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"No space left|disk.*full|ENOSPC\" [1m]) > 0",
              "for": "0m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "critical",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
              "alert": "payment-api_kafka_KafkaUnderReplicatedPartitions",
              "annotations": {
                "description": "Kafka has under-replicated partitions. Data durability may be at risk.",
                "summary": "[payment-api/kafka] Kafka under-replicated partitions"
              },
              "expr": "count_over_time({app=\"kafka\", service=\"payment-api\"} |~ \"under.?replicated|UnderReplicated\" [1m]) > 0",
              "for": "5m",
              "labels": {
                "dependency": "kafka",
                "service": "payment-api",
                "severity": "critical",
                "source": "dependency",
                "team": "payments-team",
                "technology": "kafka",
                "tier": "critical"
              }
            },
            {
