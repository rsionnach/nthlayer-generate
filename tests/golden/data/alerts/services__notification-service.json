{
  "groups": [
    {
      "name": "notification-service-slo",
      "rules": [
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:availability:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "notification-service: SLO job-success-rate not evaluable"
          },
          "expr": "absent(slo:availability:ratio{service=\"notification-service\",slo=\"job-success-rate\"}) or (slo:availability:ratio{service=\"notification-service\",slo=\"job-success-rate\"} != slo:availability:ratio{service=\"notification-service\",slo=\"job-success-rate\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "notification-service",
            "severity": "info",
            "slo": "job-success-rate",
            "team": "platform",
            "tier": "standard"
          }
        },
        {
          "alert": "SLONotEvaluable",
          "annotations": {
            "description": "slo:latency:ratio has no value or is NaN, so the SLO cannot be evaluated. The service may be receiving no traffic, or its metrics are missing. Not evaluable is not within objective.",
            "summary": "notification-service: SLO processing-time-p95 not evaluable"
          },
          "expr": "absent(slo:latency:ratio{service=\"notification-service\",slo=\"processing-time-p95\"}) or (slo:latency:ratio{service=\"notification-service\",slo=\"processing-time-p95\"} != slo:latency:ratio{service=\"notification-service\",slo=\"processing-time-p95\"})",
          "for": "1h",
          "labels": {
            "routing": "self",
            "service": "notification-service",
            "severity": "info",
            "slo": "processing-time-p95",
            "team": "platform",
            "tier": "standard"
          }
        }
      ]
    }
  ]
}
