{
  "exit": 0,
  "files": {
    "alerts.yaml": {
      "groups": [
        {
          "name": "search-api-elasticsearch",
          "rules": [
            {
              "alert": "ElasticsearchClusterRed",
              "annotations": {
                "description": "Elastic Cluster Red status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Cluster Red (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_status{color=\"red\"} == 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchDiskOutOfSpace",
              "annotations": {
                "description": "The disk usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch disk out of space (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 10",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHealthyDataNodes",
              "annotations": {
                "description": "Missing data node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Healthy Data Nodes (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_number_of_data_nodes < 3",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHealthyNodes",
              "annotations": {
                "description": "Missing node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Healthy Nodes (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_number_of_nodes < 3",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHeapUsageTooHigh",
              "annotations": {
                "description": "The heap usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Heap Usage Too High (instance {{ $labels.instance }})"
              },
              "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 90",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchUnassignedShards",
              "annotations": {
                "description": "Elasticsearch has unassigned shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch unassigned shards (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_unassigned_shards > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            }
          ]
        },
        {
          "name": "search-api-redis",
          "rules": [
            {
              "alert": "RedisClusterFlapping",
              "annotations": {
                "description": "Changes have been detected in Redis replica connection. This can occur when replica nodes lose connection to the master and reconnect (a.k.a flapping).\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis cluster flapping (instance {{ $labels.instance }})"
              },
              "expr": "changes(redis_connected_slaves[1m]) > 1",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisDisconnectedSlaves",
              "annotations": {
                "description": "Redis not replicating for all slaves. Consider reviewing the redis replication status.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis disconnected slaves (instance [instance unavailable])"
              },
              "expr": "count without (instance, job) (redis_connected_slaves) - sum without (instance, job) (redis_connected_slaves) - 1 > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisDown",
              "annotations": {
                "description": "Redis instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis down (instance {{ $labels.instance }})"
              },
              "expr": "redis_up == 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisMissingBackup",
              "annotations": {
                "description": "Redis has not been backuped for 24 hours\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis missing backup (instance {{ $labels.instance }})"
              },
              "expr": "time() - redis_rdb_last_save_timestamp_seconds > 60 * 60 * 24",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisMissingMaster",
              "annotations": {
                "description": "Redis cluster has no node marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis missing master (instance [instance unavailable])"
              },
              "expr": "(count(redis_instance_info{role=\"master\"}) or vector(0)) < 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisRejectedConnections",
              "annotations": {
                "description": "Some connections to Redis has been rejected\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis rejected connections (instance {{ $labels.instance }})"
              },
              "expr": "increase(redis_rejected_connections_total[1m]) > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisReplicationBroken",
              "annotations": {
                "description": "Redis instance lost a slave\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis replication broken (instance {{ $labels.instance }})"
              },
              "expr": "delta(redis_connected_slaves[1m]) < 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "RedisTooManyMasters",
              "annotations": {
                "description": "Redis cluster has too many nodes marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Redis too many masters (instance [instance unavailable])"
              },
              "expr": "count(redis_instance_info{role=\"master\"}) > 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            }
          ]
        }
      ]
    }
  },
  "text": [
    "",
    "╭──╮",
    "│ Generate Alerts  │",
    "╰──╯",
    "",
    "╭──╮",
    "│ Generate Alerts  │",
    "╰──╯",
    "",
    "Service: <tmp>/_staged/services/search-api.yaml",
    "Environment: dev",
    "Output: <tmp>/out/alerts.yaml",
    "",
