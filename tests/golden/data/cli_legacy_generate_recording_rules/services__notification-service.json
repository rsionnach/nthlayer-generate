{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "notification-service_health_metrics",
          "rules": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service"
              },
              "record": "service:http_request_duration_seconds:p99"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"notification-service\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"notification-service\"}[5m]))",
              "labels": {
                "service": "notification-service"
              },
              "record": "service:http_requests:rate5m"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "notification-service_slo_metrics",
          "rules": [
            {
              "expr": "slo:error_requests_failed:30d{service=\"notification-service\",slo=\"job-success-rate\"} / slo:error_requests_total:30d{service=\"notification-service\",slo=\"job-success-rate\"}",
              "labels": {
                "objective": "99.5",
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:error_rate:ratio"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"notification-service\",status=~\"5..\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:error_requests_failed:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"notification-service\"}[30d]))",
              "labels": {
                "service": "notification-service",
                "slo": "job-success-rate"
              },
              "record": "slo:error_requests_total:30d"
            }
          ]
        }
      ]
    }
  }
}
