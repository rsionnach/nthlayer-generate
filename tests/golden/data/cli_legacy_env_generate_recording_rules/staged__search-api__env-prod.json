{
  "exit": 0,
  "files": {
    "recording-rules.yaml": {
      "groups": [
        {
          "interval": "30s",
          "name": "search-api_health_metrics",
          "rules": [
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api"
              },
              "record": "service:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api"
              },
              "record": "service:http_request_duration_seconds:p99"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"search-api\",status=~\"5..\"}[5m])) / sum(rate(http_requests_total{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api"
              },
              "record": "service:http_errors:rate5m"
            },
            {
              "expr": "sum(rate(http_requests_total{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api"
              },
              "record": "service:http_requests:rate5m"
            }
          ]
        },
        {
          "interval": "30s",
          "name": "search-api_slo_metrics",
          "rules": [
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"search-api\",slo=\"availability\"}) / (1 - 0.9990000000000001))",
              "labels": {
                "objective": "99.9",
                "service": "search-api",
                "slo": "availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "1 - ((1 - slo:availability:ratio{service=\"search-api\",slo=\"search-availability\"}) / (1 - 0.995))",
              "labels": {
                "objective": "99.5",
                "service": "search-api",
                "slo": "search-availability"
              },
              "record": "slo:error_budget_remaining:ratio"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.5, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "search-latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p50"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "search-latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p95"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p99"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{service=\"search-api\"}[5m]))",
              "labels": {
                "service": "search-api",
                "slo": "search-latency-p95"
              },
              "record": "slo:http_request_duration_seconds:p99"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"search-api\",slo=\"latency-p95\"} / slo:latency_requests_total:30d{service=\"search-api\",slo=\"latency-p95\"}",
              "labels": {
                "objective": "99.0",
                "service": "search-api",
                "slo": "latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"search-api\",slo=\"latency-p99\"} / slo:latency_requests_total:30d{service=\"search-api\",slo=\"latency-p99\"}",
              "labels": {
                "objective": "95.0",
                "service": "search-api",
                "slo": "latency-p99"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:latency_requests_fast:30d{service=\"search-api\",slo=\"search-latency-p95\"} / slo:latency_requests_total:30d{service=\"search-api\",slo=\"search-latency-p95\"}",
              "labels": {
                "objective": "99.0",
                "service": "search-api",
                "slo": "search-latency-p95"
              },
              "record": "slo:latency:ratio"
            },
            {
              "expr": "slo:requests_success:30d{service=\"search-api\",slo=\"availability\"} / slo:requests_total:30d{service=\"search-api\",slo=\"availability\"}",
              "labels": {
                "objective": "99.9",
                "service": "search-api",
                "slo": "availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "slo:requests_success:30d{service=\"search-api\",slo=\"search-availability\"} / slo:requests_total:30d{service=\"search-api\",slo=\"search-availability\"}",
              "labels": {
                "objective": "99.5",
                "service": "search-api",
                "slo": "search-availability"
              },
              "record": "slo:availability:ratio"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"search-api\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p95",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"search-api\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p99",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_bucket{service=\"search-api\",le=\"0.5\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "search-latency-p95",
                "threshold": "500ms"
              },
              "record": "slo:latency_requests_fast:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"search-api\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"search-api\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "latency-p99"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_request_duration_seconds_count{service=\"search-api\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "search-latency-p95"
              },
              "record": "slo:latency_requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"search-api\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"search-api\",status!~\"5..\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "search-availability"
              },
              "record": "slo:requests_success:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"search-api\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "availability"
              },
              "record": "slo:requests_total:30d"
            },
            {
              "expr": "sum(increase(http_requests_total{service=\"search-api\"}[30d]))",
              "labels": {
                "service": "search-api",
                "slo": "search-availability"
              },
              "record": "slo:requests_total:30d"
            }
          ]
        }
      ]
    }
  }
}
