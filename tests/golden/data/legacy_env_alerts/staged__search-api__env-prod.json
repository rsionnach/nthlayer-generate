{
  "count": 31,
  "file": {
    "groups": [
      {
        "name": "search-api-elasticsearch",
        "rules": [
          {
            "alert": "ElasticsearchClusterRed",
            "annotations": {
              "description": "Elastic Cluster Red status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Cluster Red (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_status{color=\"red\"} == 1",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchClusterYellow",
            "annotations": {
              "description": "Elastic Cluster Yellow status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Cluster Yellow (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_status{color=\"yellow\"} == 1",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchDiskOutOfSpace",
            "annotations": {
              "description": "The disk usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch disk out of space (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 10",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchDiskSpaceLow",
            "annotations": {
              "description": "The disk usage is over 80%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch disk space low (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 20",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHealthyDataNodes",
            "annotations": {
              "description": "Missing data node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Healthy Data Nodes (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_number_of_data_nodes < 3",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHealthyNodes",
            "annotations": {
              "description": "Missing node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Healthy Nodes (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_number_of_nodes < 3",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHeapUsageTooHigh",
            "annotations": {
              "description": "The heap usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Heap Usage Too High (instance {{ $labels.instance }})"
            },
            "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 90",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHeapUsageWarning",
            "annotations": {
              "description": "The heap usage is over 80%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch Heap Usage warning (instance {{ $labels.instance }})"
            },
            "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 80",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHighIndexingLatency",
            "annotations": {
              "description": "The indexing latency on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch High Indexing Latency (instance {{ $labels.instance }})"
            },
            "expr": "increase(elasticsearch_indices_indexing_index_time_seconds_total[1m]) / increase(elasticsearch_indices_indexing_index_total[1m]) > 0.0005",
            "for": "10m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHighIndexingRate",
            "annotations": {
              "description": "The indexing rate on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch High Indexing Rate (instance [instance unavailable])"
            },
            "expr": "sum(rate(elasticsearch_indices_indexing_index_total[1m]))> 10000",
            "for": "5m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHighQueryLatency",
            "annotations": {
              "description": "The query latency on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch High Query Latency (instance {{ $labels.instance }})"
            },
            "expr": "increase(elasticsearch_indices_search_fetch_time_seconds[1m]) / increase(elasticsearch_indices_search_fetch_total[1m]) > 1",
            "for": "5m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchHighQueryRate",
            "annotations": {
              "description": "The query rate on Elasticsearch cluster is higher than the threshold.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch High Query Rate (instance [instance unavailable])"
            },
            "expr": "sum(rate(elasticsearch_indices_search_query_total[1m])) > 100",
            "for": "5m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchInitializingShards",
            "annotations": {
              "description": "Elasticsearch is initializing shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch initializing shards (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_initializing_shards > 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "info",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchInitializingShardsTooLong",
            "annotations": {
              "description": "Elasticsearch has been initializing shards for 15 min\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch initializing shards too long (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_initializing_shards > 0",
            "for": "15m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchNoNewDocuments",
            "annotations": {
              "description": "No new documents for 10 min!\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch no new documents (instance {{ $labels.instance }})"
            },
            "expr": "increase(elasticsearch_indices_indexing_index_total{es_data_node=\"true\"}[10m]) < 1",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchPendingTasks",
            "annotations": {
              "description": "Elasticsearch has pending tasks. Cluster works slowly.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch pending tasks (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_number_of_pending_tasks > 0",
            "for": "15m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchRelocatingShards",
            "annotations": {
              "description": "Elasticsearch is relocating shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch relocating shards (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_relocating_shards > 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "info",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchRelocatingShardsTooLong",
            "annotations": {
              "description": "Elasticsearch has been relocating shards for 15min\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch relocating shards too long (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_relocating_shards > 0",
            "for": "15m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "ElasticsearchUnassignedShards",
            "annotations": {
              "description": "Elasticsearch has unassigned shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Elasticsearch unassigned shards (instance {{ $labels.instance }})"
            },
            "expr": "elasticsearch_cluster_health_unassigned_shards > 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          }
        ]
      },
      {
        "name": "search-api-redis",
        "rules": [
          {
            "alert": "RedisClusterFlapping",
            "annotations": {
              "description": "Changes have been detected in Redis replica connection. This can occur when replica nodes lose connection to the master and reconnect (a.k.a flapping).\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis cluster flapping (instance {{ $labels.instance }})"
            },
            "expr": "changes(redis_connected_slaves[1m]) > 1",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisDisconnectedSlaves",
            "annotations": {
              "description": "Redis not replicating for all slaves. Consider reviewing the redis replication status.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis disconnected slaves (instance [instance unavailable])"
            },
            "expr": "count without (instance, job) (redis_connected_slaves) - sum without (instance, job) (redis_connected_slaves) - 1 > 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisDown",
            "annotations": {
              "description": "Redis instance is down\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis down (instance {{ $labels.instance }})"
            },
            "expr": "redis_up == 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisMissingBackup",
            "annotations": {
              "description": "Redis has not been backuped for 24 hours\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis missing backup (instance {{ $labels.instance }})"
            },
            "expr": "time() - redis_rdb_last_save_timestamp_seconds > 60 * 60 * 24",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisMissingMaster",
            "annotations": {
              "description": "Redis cluster has no node marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis missing master (instance [instance unavailable])"
            },
            "expr": "(count(redis_instance_info{role=\"master\"}) or vector(0)) < 1",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisNotEnoughConnections",
            "annotations": {
              "description": "Redis instance should have more connections (> 5)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis not enough connections (instance {{ $labels.instance }})"
            },
            "expr": "redis_connected_clients < 5",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisOutOfConfiguredMaxmemory",
            "annotations": {
              "description": "Redis is running out of configured maxmemory (> 90%)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis out of configured maxmemory (instance {{ $labels.instance }})"
            },
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100 > 90 and on(instance) redis_memory_max_bytes > 0",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisOutOfSystemMemory",
            "annotations": {
              "description": "Redis is running out of system memory (> 90%)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis out of system memory (instance {{ $labels.instance }})"
            },
            "expr": "redis_memory_used_bytes / redis_total_system_memory_bytes * 100 > 90",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisRejectedConnections",
            "annotations": {
              "description": "Some connections to Redis has been rejected\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis rejected connections (instance {{ $labels.instance }})"
            },
            "expr": "increase(redis_rejected_connections_total[1m]) > 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisReplicationBroken",
            "annotations": {
              "description": "Redis instance lost a slave\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis replication broken (instance {{ $labels.instance }})"
            },
            "expr": "delta(redis_connected_slaves[1m]) < 0",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisTooManyConnections",
            "annotations": {
              "description": "Redis is running out of connections (> 90% used)\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis too many connections (instance {{ $labels.instance }})"
            },
            "expr": "redis_connected_clients / redis_config_maxclients * 100 > 90",
            "for": "2m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "warning",
              "team": "search",
              "tier": "critical"
            }
          },
          {
            "alert": "RedisTooManyMasters",
            "annotations": {
              "description": "Redis cluster has too many nodes marked as master.\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
              "summary": "Redis too many masters (instance [instance unavailable])"
            },
            "expr": "count(redis_instance_info{role=\"master\"}) > 1",
            "for": "1m",
            "labels": {
              "routing": "self",
              "service": "search-api",
              "severity": "critical",
              "team": "search",
              "tier": "critical"
            }
          }
        ]
      }
    ]
  }
}
