{
  "exit": 0,
  "files": {
    "alerts.yaml": {
      "groups": [
        {
          "name": "search-api-elasticsearch",
          "rules": [
            {
              "alert": "ElasticsearchClusterRed",
              "annotations": {
                "description": "Elastic Cluster Red status\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Cluster Red (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_status{color=\"red\"} == 1",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchDiskOutOfSpace",
              "annotations": {
                "description": "The disk usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch disk out of space (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_filesystem_data_available_bytes / elasticsearch_filesystem_data_size_bytes * 100 < 10",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHealthyDataNodes",
              "annotations": {
                "description": "Missing data node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Healthy Data Nodes (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_number_of_data_nodes < 3",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHealthyNodes",
              "annotations": {
                "description": "Missing node in Elasticsearch cluster\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Healthy Nodes (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_number_of_nodes < 3",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchHeapUsageTooHigh",
              "annotations": {
                "description": "The heap usage is over 90%\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch Heap Usage Too High (instance {{ $labels.instance }})"
              },
              "expr": "(elasticsearch_jvm_memory_used_bytes{area=\"heap\"} / elasticsearch_jvm_memory_max_bytes{area=\"heap\"}) * 100 > 90",
              "for": "2m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            },
            {
              "alert": "ElasticsearchUnassignedShards",
              "annotations": {
                "description": "Elasticsearch has unassigned shards\n  VALUE = {{ $value }}\n  LABELS = {{ $labels }}",
                "summary": "Elasticsearch unassigned shards (instance {{ $labels.instance }})"
              },
              "expr": "elasticsearch_cluster_health_unassigned_shards > 0",
              "for": "1m",
              "labels": {
                "routing": "self",
                "service": "search-api",
                "severity": "critical",
                "team": "search",
                "tier": "low"
              }
            }
          ]
        }
      ]
    }
  },
  "text": [
    "",
    "╭──╮",
    "│ Generate Alerts  │",
    "╰──╯",
    "",
    "╭──╮",
    "│ Generate Alerts  │",
    "╰──╯",
    "",
    "Service: <tmp>/_staged/services/search-api.yaml",
    "Environment: dev",
    "Output: <tmp>/out/alerts.yaml",
    "",
