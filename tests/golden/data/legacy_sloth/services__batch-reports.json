{
  "slo_count": 3,
  "spec": {
    "labels": {
      "team": "data",
      "tier": "low",
      "type": "api"
    },
    "service": "batch-reports",
    "slos": [
      {
        "alerting": {
          "annotations": {
            "summary": "SLO availability for batch-reports"
          },
          "labels": {
            "service": "batch-reports",
            "tier": "low"
          },
          "name": "BatchReportsAvailability",
          "ticket_alert": {
            "annotations": {
              "summary": "Error budget burn on batch-reports"
            },
            "labels": {
              "severity": "warning"
            }
          }
        },
        "description": "99.0% availability",
        "name": "availability",
        "objective": 99.0,
        "sli": {
          "events": {
            "error_query": "sum(rate(http_requests_total{service=\"batch-reports\",code=~\"5..\"}[5m]))",
            "total_query": "sum(rate(http_requests_total{service=\"batch-reports\"}[5m]))"
          }
        }
      },
      {
        "alerting": {
          "annotations": {
            "summary": "SLO latency-p95 for batch-reports"
          },
          "labels": {
            "service": "batch-reports",
            "tier": "low"
          },
          "name": "BatchReportsLatencyP95",
          "ticket_alert": {
            "annotations": {
              "summary": "Error budget burn on batch-reports"
            },
            "labels": {
              "severity": "warning"
            }
          }
        },
        "description": "90.0% latency p95",
        "name": "latency-p95",
        "objective": 90.0,
        "sli": {
          "events": {
            "error_query": "histogram_quantile(0.95,\n  rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m])\n)\n > 2.0",
            "total_query": "sum(rate(0.95,\n  rate(http_request_duration_seconds_bucket{service=\"batch-reports\"}[5m])\n)\n)"
          }
        }
      },
      {
        "alerting": {
          "annotations": {
            "summary": "SLO report-success-rate for batch-reports"
          },
          "labels": {
            "service": "batch-reports",
            "tier": "low"
          },
